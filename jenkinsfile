pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }


        stage('Backend Setup') {
            steps {

                bat '''
                cd backend
                python -m pip install --upgrade pip
                pip install -r requirements.txt
                python manage.py check
                '''

            }
        }


        stage('Frontend Setup') {

            steps {

                bat '''
                cd frontend
                npm ci
                '''

            }
        }

        stage('Lint Frontend') {

            steps {

                bat '''
                cd frontend
                npm run lint
                '''

            }
        }


        stage('Build Frontend') {

            steps {

                bat '''
                cd frontend
                if exist dist rmdir /s /q dist
                npm run build
                '''

            }

        }

        stage('Docker Compose Build') {

            steps {

                bat '''
                docker compose build
                docker compose config
                '''

            }
        }


        stage('Pipeline Completed') {

            steps {
                echo 'TrustKhata CI/CD Completed Successfully'
            }

        }

    }
}
